      allow read: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid}/blocks/{targetUid} {
      // Block lists are private; users can only manage their own block records.
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && targetUid != uid
        && request.resource.data.keys().hasOnly(['targetUid', 'createdAt'])
