rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verifiedOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    match /profilePhotos/{uid}/avatar {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      allow create, update: if verifiedOwner(uid)
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.metadata.ownerUid == uid;
      allow delete: if verifiedOwner(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}